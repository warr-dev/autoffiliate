# ==============================================================================
# Hostinger SSH Deployment Configuration
# Copy this file to .env.deploy to enable 1-click build & deploy via ./deploy.sh --ssh
# ==============================================================================

# Server IP Address or Domain
DEPLOY_HOST=185.xxx.xxx.xxx

# SSH Username (e.g. u123456789 on hPanel, or root on VPS)
DEPLOY_USER=u123456789

# SSH Port (Hostinger hPanel standard is 65002, VPS standard is 22)
DEPLOY_PORT=65002

# Absolute Path to Application on Hostinger Server
DEPLOY_PATH=/home/u123456789/domains/yourdomain.com/app

# Optional SSH Password (If not using SSH keys)
# DEPLOY_PASSWORD=your_ssh_password_here
